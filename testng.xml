<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- parallel="methods" thread-count="3": three tests run at the same time, each with its own browser -->
<suite name="SauceDemo Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.saucedemo.listeners.TestListener"/>
        <listener class-name="com.saucedemo.listeners.RetryTransformer"/>
    </listeners>
    <test name="SauceDemo Tests">
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
            <class name="com.saucedemo.tests.ProductsTest"/>
            <class name="com.saucedemo.tests.CartTest"/>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
